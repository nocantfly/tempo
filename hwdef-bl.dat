MCU STM32H750xx STM32H750xx
APJ_BOARD_ID 1234
OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 128
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 32

# External Flash W25Q64 8MB
EXT_FLASH_SIZE_MB 8
EXT_FLASH_RESERVE_START_KB 0
EXT_FLASH_RESERVE_END_KB 0

# LDO
mcuconf STM32_PWR_CR3 STM32_PWR_CR3_LDOEN

# QSPI device - QUAN TRONG
PB2  QUADSPI_CLK      QUADSPI1 SPEED_HIGH
PB6  QUADSPI_BK1_NCS  QUADSPI1 SPEED_HIGH
PF8  QUADSPI_BK1_IO0  QUADSPI1 SPEED_HIGH
PF9  QUADSPI_BK1_IO1  QUADSPI1 SPEED_HIGH
PF7  QUADSPI_BK1_IO2  QUADSPI1 SPEED_HIGH
PF6  QUADSPI_BK1_IO3  QUADSPI1 SPEED_HIGH
QSPIDEV w25q QUADSPI1 MODE3 100*MHZ 23 1

# USB
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
define BOARD_NO_VBUS_SENSING 1
define HAL_OTG_IGNORE_VBUS 1
define HAL_PWR_ENABLE_USB_REGULATOR 1
define CBRD_OTG_FORCE_DEVICE_MODE 1


# RAM
define HAL_RAM_RESERVE_START 192
define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384

SYS_USB_OTG1_FS
